# Deny direct browser access to the SQLite database file
<Files "*.sqlite">
    Order allow,deny
    Deny from all
</Files>

# Deny access to PHP config/logic files that should only be included, not called directly
<FilesMatch "^(config|excel)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Optional: set default charset
AddDefaultCharset UTF-8
